diff -ruN --show-c-function sys/amd64/amd64/trap.c sys/amd64/amd64/trap.c
--- sys/amd64/amd64/trap.c	2026-03-20 13:39:51.104286000 -0700
+++ sys/amd64/amd64/trap.c	2026-03-20 19:16:44.071209000 -0700
@@ -63,6 +63,8 @@
 #include <sys/signalvar.h>
 #include <sys/syscall.h>
 #include <sys/sysctl.h>
+#include <sys/malloc.h>
+#include <sys/sud.h>
 #include <sys/sysent.h>
 #include <sys/uio.h>
 #include <sys/vmmeter.h>
@@ -111,6 +113,8 @@ static bool trap_user_dtrace(struct trapframe *,
     int (**hook)(struct trapframe *));
 #endif
 
+MALLOC_DEFINE(M_SUD, "sud", "Syscall User Dispatch state");
+
 static const char UNKNOWN[] = "unknown";
 static const char *const trap_msg[] = {
 	[0] =			UNKNOWN,			/* unused */
@@ -1245,4 +1249,67 @@ amd64_syscall(struct thread *td, int traced)
 		set_pcb_flags(td->td_pcb, PCB_FULL_IRET);
 
 	amd64_syscall_ret_flush_l1d_check_inline(td->td_errno);
+}
+
+/*
+ * amd64_syscall_sud_check(frame)
+ *
+ * Called from fast_syscall_common (exception.S) when td_sud != NULL and
+ * TF_RIP is outside the registered allow-range.
+ *
+ * Interrupts are ENABLED on entry: fast_syscall_common emits `sti` before
+ * our insertion point, so fubyte(9) can safely take a page fault if the
+ * selector byte is paged out.
+ *
+ * Reads *ss_selector via fubyte(9): safe single-byte userspace fetch
+ * with automatic page-fault handling. Returns the byte value (0-255)
+ * or -1 on fault. We treat -1 as ALLOW (fail-open) so that a process
+ * with a transiently unmapped selector page is not permanently wedged.
+ *
+ * On BLOCK (selector == SYSCALL_DISPATCH_FILTER_BLOCK):
+ * - The Windows syscall number currently in tf_rax is saved into
+ * ksi_syscall before tf_rax is overwritten with ENOSYS, so Wine's
+ * SIGSYS handler can identify and emulate the call.
+ * - Returns 1; caller (exception.S) skips amd64_syscall().
+ * SIGSYS delivery happens via the normal AST / userret() path.
+ *
+ * On ALLOW or fault: returns 0; caller proceeds to amd64_syscall().
+ */
+int
+amd64_syscall_sud_check(struct trapframe *frame)
+{
+	struct thread *td;
+	struct sud_state *ss;
+	ksiginfo_t ksi;
+	int sel;
+
+	td = curthread;
+	ss = td->td_sud;
+	if (ss == NULL)
+		return (0);
+
+	/* Exempt libthr signal trampoline syscalls so threads can exit
+	 * signal handlers safely without deadlocking inside SUD.
+	 */
+	if (frame->tf_rax == SYS_sigreturn || frame->tf_rax == SYS_sigfastblock)
+		return (0);
+
+	sel = fubyte(ss->ss_selector);
+	if (sel != SYSCALL_DISPATCH_FILTER_BLOCK)
+		return (0);		/* ALLOW or page fault -> proceed */
+
+	/*
+	 * BLOCK: capture the Windows syscall number before overwriting
+	 * tf_rax, so Wine's SIGSYS handler sees it in si_syscall.
+	 */
+	ksiginfo_init(&ksi);
+	ksi.ksi_signo   = SIGSYS;
+	ksi.ksi_code    = SIGSYS_DISPATCH;
+	ksi.ksi_info.si_syscall = (int)frame->tf_rax;
+	ksi.ksi_addr    = (void *)frame->tf_rip;
+
+	frame->tf_rax   = ENOSYS;
+
+	trapsignal(td, &ksi);
+	return (1);
 }
