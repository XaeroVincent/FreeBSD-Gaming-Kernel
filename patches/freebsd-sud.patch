diff -ruN --show-c-function sys/amd64/amd64/exception.S sys/amd64/amd64/exception.S
--- sys/amd64/amd64/exception.S	2026-03-20 13:39:51.104708000 -0700
+++ sys/amd64/amd64/exception.S	2026-03-20 14:14:59.020455000 -0700
@@ -567,8 +567,71 @@ fast_syscall_common:
 	movq	%rsp,TD_FRAME(%rdi)
 	movl	TF_RFLAGS(%rsp),%esi
 	andl	$PSL_T,%esi
+
+	/*
+	 * Syscall User Dispatch (SUD) hot-path check.
+	 *
+	 * If td_sud is non-NULL and TF_RIP is outside the registered
+	 * allow-range [ss_start, ss_start+ss_len), call the C helper which
+	 * reads the userspace selector byte and optionally queues SIGSYS.
+	 *
+	 * Register state at this point:
+	 * %rdi  = curthread  (loaded four instructions above)
+	 * %esi  = PSL_T flag (must survive into amd64_syscall)
+	 * %r10  = caller-saved, already saved in trapframe; use as scratch
+	 * %r11  = caller-saved, already saved in trapframe; use as scratch
+	 *
+	 * Interrupt state:
+	 * fast_syscall_common emits `sti` earlier in the function, after
+	 * handle_ibrs_entry() and before saving the remaining GPRs.
+	 * Interrupts are therefore already ENABLED at this point.
+	 * The `sti` below is a no-op in the current code; it is kept as
+	 * explicit documentation that IF=1 is required before the call to
+	 * amd64_syscall_sud_check(), which calls fubyte(9), which may
+	 * page-fault (trap_pfault panics if called with IF=0). On the
+	 * BLOCK path we jump to label 1: where the existing `cli`
+	 * re-disables interrupts before the PCB_FULL_IRET test.
+	 *
+	 * Register saving:
+	 * The C ABI treats %rsi/%rdi as caller-saved; both are clobbered
+	 * by amd64_syscall_sud_check().  We re-derive them from the
+	 * trapframe on the ALLOW return path. %r10 is scratch for the
+	 * range check and is not needed afterward.
+	 */
+	movq	TD_SUD(%rdi),%r11		/* r11 = td_sud pointer */
+	testq	%r11,%r11
+	jz	.Lfast_syscall_sud_pass		/* NULL -> SUD disabled */
+
+	/* Unsigned range check: (TF_RIP - ss_start) < ss_len ? */
+	movq	TF_RIP(%rsp),%r10		/* saved user RIP */
+	subq	SUD_START(%r11),%r10		/* r10 = rip - start (unsigned) */
+	cmpq	SUD_LEN(%r11),%r10
+	jb	.Lfast_syscall_sud_pass		/* inside allow-range: proceed */
+
+	/*
+	 * RIP is outside the allow-range. IF is already 1 (see above).
+	 * The `sti` here is a no-op but documents the requirement explicitly.
+	 */
+	sti
+	movq	%rsp,%rdi			/* arg0: trapframe * */
+	call	amd64_syscall_sud_check
+	testl	%eax,%eax
+	jnz	.Lfast_syscall_sud_done		/* BLOCK: SIGSYS queued */
+
+	/*
+	 * ALLOW path: %rdi and %esi were clobbered by the C call.
+	 * Reload curthread and re-derive the PSL_T flag from the trapframe.
+	 * Interrupts remain enabled; amd64_syscall() expects that.
+	 */
+	movq	PCPU(CURTHREAD),%rdi
+	movl	TF_RFLAGS(%rsp),%esi
+	andl	$PSL_T,%esi
+
+.Lfast_syscall_sud_pass:
 	call	amd64_syscall
+.Lfast_syscall_sud_done:
 1:	movq	PCPU(CURPCB),%rax
+
 	/* Disable interrupts before testing PCB_FULL_IRET. */
 	cli
 	testl	$PCB_FULL_IRET,PCB_FLAGS(%rax)
