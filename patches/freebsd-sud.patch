diff -ruN --show-c-function sys/sys/sud.h sys/sys/sud.h
--- sys/sys/sud.h	1969-12-31 16:00:00.000000000 -0800
+++ sys/sys/sud.h	2026-03-20 14:14:59.023035000 -0700
@@ -0,0 +1,73 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Copyright (c) 2026 The FreeBSD Project
+ *
+ * Syscall User Dispatch (SUD).
+ */
+
+#ifndef _SYS_SUD_H_
+#define	_SYS_SUD_H_
+
+#include <sys/types.h>
+
+/*
+ * Selector byte values written by userspace to control dispatch.
+ * ALLOW (0): execute the syscall normally.
+ * BLOCK (1): deliver SIGSYS instead.
+ */
+#define	SYSCALL_DISPATCH_FILTER_ALLOW	0
+#define	SYSCALL_DISPATCH_FILTER_BLOCK	1
+
+/*
+ * Argument structure for procctl(2) PROC_SUD_SET.
+ */
+struct proc_sud_ctl {
+	uintptr_t	sud_start;	/* allow-range base VA (inclusive) */
+	size_t		sud_len;	/* allow-range length in bytes */
+	uint8_t		*sud_selector;	/* userspace selector byte pointer */
+};
+
+/*
+ * Per-thread kernel state. Hung off struct thread as td_sud.
+ * NULL means SUD is disabled for that thread.
+ *
+ * Field offsets exported to assembly via genassym.c:
+ * SUD_START    = offsetof(struct sud_state, ss_start)
+ * SUD_LEN      = offsetof(struct sud_state, ss_len)
+ * SUD_SELECTOR = offsetof(struct sud_state, ss_selector)
+ */
+struct sud_state {
+	uintptr_t	ss_start;	/* allow-range base VA */
+	size_t		ss_len;		/* allow-range length in bytes */
+	uint8_t		*ss_selector;	/* userspace selector byte pointer */
+};
+
+#ifdef _KERNEL
+
+#include <sys/malloc.h>
+
+struct thread;
+struct trapframe;
+
+MALLOC_DECLARE(M_SUD);
+
+/*
+ * Called from fast_syscall_common (exception.S) when td_sud != NULL and
+ * TF_RIP is outside the allow-range. Interrupts are ENABLED on entry
+ * (fast_syscall_common emits `sti` before our insertion point).
+ *
+ * Returns 0: proceed with amd64_syscall() (ALLOW or fubyte fault).
+ * Returns 1: SIGSYS queued; caller must skip amd64_syscall().
+ */
+int	amd64_syscall_sud_check(struct trapframe *frame);
+
+/*
+ * Disable SUD for td and free its state. Safe when td_sud == NULL.
+ * Called from exec path and thread teardown.
+ */
+void	thread_sud_clear(struct thread *td);
+
+#endif /* _KERNEL */
+
+#endif /* !_SYS_SUD_H_ */
