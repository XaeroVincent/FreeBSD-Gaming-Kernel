@@ -1161,6 +1177,7 @@ sys_procctl(struct thread *td, struct procctl_args *ua
 		struct procctl_reaper_status rs;
 		struct procctl_reaper_pids rp;
 		struct procctl_reaper_kill rk;
+		struct proc_sud_ctl sud;
 		int flags;
 	} x;
 	const struct procctl_cmd_info *cmd_info;
@@ -1191,6 +1208,95 @@ sys_procctl(struct thread *td, struct procctl_args *ua
 			error = error1;
 	}
 	return (error);
+}
+
+/*
+ * sud_set -- enable Syscall User Dispatch for the calling thread.
+ *
+ * data points to a struct proc_sud_ctl already copyin'd by sys_procctl()
+ * (copyin_sz = sizeof(struct proc_sud_ctl)).
+ *
+ * SUD is self-only (matching Linux PR_SET_SYSCALL_USER_DISPATCH): only
+ * the calling thread (td) is modified.  This avoids a use-after-free
+ * race: the hot-path in amd64_syscall_sud_check() reads td->td_sud
+ * without any lock, so concurrent cross-thread writes would be unsafe.
+ * With self-only semantics td is currently executing this syscall and
+ * therefore cannot simultaneously be in the hot-path.
+ *
+ * Callers must target their own process (p == td->td_proc). The
+ * procctl framework allows one_proc=true operations to name any
+ * accessible process; we reject cross-process calls with EPERM because
+ * the operation is inherently per-calling-thread and applying it to a
+ * foreign process's thread is not meaningful.
+ *
+ * The new sud_state is allocated before the old one is freed so that on
+ * ENOMEM the existing configuration is left intact. M_NOWAIT is used
+ * because PROC_LOCK is held; in practice the struct is 24 bytes and
+ * allocation failure here is implausible.
+ *
+ * p is PROC_LOCKed on entry and must remain so on return (procctl
+ * framework requirement). No thread_lock is needed: we are td, and td
+ * cannot be running on another CPU while executing this syscall.
+ */
+static int
+sud_set(struct thread *td, struct proc *p, void *data)
+{
+	const struct proc_sud_ctl *ctl;
+	struct sud_state *ss;
+
+	PROC_LOCK_ASSERT(p, MA_OWNED);
+
+	/* Self-only: reject cross-process calls. */
+	if (p != td->td_proc)
+		return (EPERM);
+
+	ctl = (const struct proc_sud_ctl *)data;
+
+	if (ctl->sud_len == 0)
+		return (EINVAL);
+	if (ctl->sud_start + ctl->sud_len < ctl->sud_start)	/* VA wrap */
+		return (EINVAL);
+	if (ctl->sud_selector == NULL)
+		return (EINVAL);
+
+	/*
+	 * Allocate the new state before touching td_sud so that on ENOMEM
+	 * the existing configuration remains intact.
+	 */
+	ss = malloc(sizeof(*ss), M_SUD, M_NOWAIT);
+	if (ss == NULL)
+		return (ENOMEM);
+
+	ss->ss_start    = ctl->sud_start;
+	ss->ss_len      = ctl->sud_len;
+	ss->ss_selector = ctl->sud_selector;
+
+	if (td->td_sud != NULL)
+		free(td->td_sud, M_SUD);
+	td->td_sud = ss;
+	return (0);
+}
+
+/*
+ * sud_clear -- disable Syscall User Dispatch for the calling thread.
+ *
+ * p is PROC_LOCKed on entry and must remain so on return.
+ * Self-only: rejects cross-process calls with EPERM for the same
+ * reasons as sud_set().
+ * thread_sud_clear() is safe here: td == curthread, so no concurrent
+ * hot-path execution is possible.
+ */
+static int
+sud_clear(struct thread *td, struct proc *p, void *data __unused)
+{
+	PROC_LOCK_ASSERT(p, MA_OWNED);
+
+	/* Self-only: reject cross-process calls. */
+	if (p != td->td_proc)
+		return (EPERM);
+
+	thread_sud_clear(td);
+	return (0);
 }
 
